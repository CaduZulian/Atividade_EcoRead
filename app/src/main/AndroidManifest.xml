<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="EcoRead"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atividade_EcoRead">

        <activity
            android:name="com.ecoread.activity.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.ecoread.activity.CadastroProprietarioActivity" />
        <activity android:name="com.ecoread.activity.CadastroApartamentoActivity" />
        <activity android:name="com.ecoread.activity.RegistroLeituraActivity" />
        <activity android:name="com.ecoread.activity.ConsultaMediaActivity" />
        <activity android:name="com.ecoread.activity.ConsultaMesActivity" />

    </application>

</manifest>